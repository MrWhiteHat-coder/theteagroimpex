[TEMPLATE]
# Copy this file to .env and fill in real values. NEVER commit .env.

# --- SMTP (Titan Mail via GoDaddy) — recommended for production ---
# Titan Mail SMTP settings (GoDaddy-hosted mailbox):
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USERNAME=support@theteagroimpex.in
SMTP_PASSWORD=your-smtp-password

# Where website enquiries are delivered (recipient mailbox)
CONTACT_RECEIVER_EMAIL=support@theteagroimpex.in

# Optional: override the From address if your provider requires it
# FROM_EMAIL=Thete Agro Impex <support@theteagroimpex.in>

# --- Alternative API providers (any ONE of these instead of SMTP) ---
# RESEND_API_KEY=
# BREVO_API_KEY=
# SENDGRID_API_KEY=
